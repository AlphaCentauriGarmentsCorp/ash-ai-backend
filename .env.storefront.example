# =============================================================================
#  REEFER storefront — extra .env keys
# =============================================================================
#  These are ADDITIONS. Append them to the ash-ai-backend `.env` you already
#  have; nothing here replaces an existing ERP key. Every one of them is
#  optional — with the file left exactly as printed below, the storefront runs
#  in its local/demo shape (simulated payments, inventory API off, no email
#  verification). See STOREFRONT_INTEGRATION.md.
#
#  Defaults shown are the ones in config/reefer.php, so an unset key and the
#  value below behave identically.
# =============================================================================

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins the storefront SPA is served from. Merged
# INTO config/cors.php's allowed_origins at runtime (the ERP's own origins are
# kept), so that file never has to be edited. Origin only: scheme + host +
# port, no path, no trailing slash. Never "*" — the API sends credentials.
#
# SET THIS FOR LOCAL DEV TOO. The committed config/cors.php reads
# CORS_ALLOWED_ORIGINS, which a fresh .env.example does not define — so on a
# clean clone the allowlist is empty and the browser blocks every request from
# the SPA while curl against the same URLs happily returns 200.
#   STOREFRONT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the production origin here as well when the storefront gets its domain.
STOREFRONT_ALLOWED_ORIGINS=

# ── Storefront base URL (used in outgoing email links) ────────────────────
# Where the SHOPPER-FACING site lives. Every link in an email — the password
# reset link, the back-in-stock "buy it now" link — is built from this.
#
# ⚠ SET THIS whenever the SPA is on a different host from this API, which is
#   the whole point of the one-backend-many-frontends setup. It defaults to
#   APP_URL, and APP_URL is THIS app: on a split deployment that is the API
#   host, whose routes/web.php serves only '/'. /reset-password and
#   /product/{slug} are client-side React routes that exist only on the
#   storefront's origin, so leaving this unset sends every reset link to a 404
#   — and because the token is single-use and the SPA has no paste-it-in
#   screen, that makes account recovery impossible rather than merely ugly.
#
# Origin only, no trailing slash. Same idea as PAYMONGO_SUCCESS_URL below.
#   STOREFRONT_SPA_URL=https://reeferclothing.com
STOREFRONT_SPA_URL=

# ── Inventory API (external stock system / ERP) ───────────────────────────
# Machine-to-machine token for /api/storefront/v1/inventory. NOT a shopper
# token: it reads and rewrites warehouse quantities for the whole catalogue.
# Leave blank and the whole surface answers 503 — off rather than half-open.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
INVENTORY_API_TOKEN=
# Warehouse label stamped on inventory rows the ERP has not named yet.
INVENTORY_WAREHOUSE="Reefer QC"
# Marketplace/channel label stamped on those same rows, so an export is never
# missing a column it expects.
INVENTORY_MARKETPLACE="REEFER (Website)"

# ── Payments ──────────────────────────────────────────────────────────────
# The single switch between simulated and real money: blank = the simulator
# auto-approves online methods and contacts nobody; set = StorefrontServiceProvider
# binds PayMongoGateway and real charges happen. Do not set it by accident.
#
# ⚠ BEFORE YOU SET THIS, fix the ordering in OrderController::store(): it calls
#   $gateway->charge() BEFORE reserveStock(). With the simulator that is harmless
#   because no money moves, which is why it was left alone. With a real key, a
#   shopper whose size sells out between browsing and paying gets CHARGED and then
#   sees the order fail — the DB transaction rolls the order back, but the charge
#   is at PayMongo, not in your database, so nothing rolls it back. Reserve first,
#   charge second, or charge only after the reservation succeeds.
PAYMONGO_SECRET_KEY=

# ── Order tracker ─────────────────────────────────────────────────────────
# ⚠ DEMO ONLY. Lets the buyer click their OWN order along the tracker in My
#   Orders (one-way, owner-scoped). Turn this OFF the moment real fulfilment
#   exists: whoever can mark their own parcel Delivered can also open its
#   returns window on it, or dispute a delivery they set themselves. Stage
#   changes then belong to the warehouse/ERP via the inventory API.
REEFER_MANUAL_ADVANCE=true
# Courier name stamped on a simulated order when it reaches Shipped, so the
# tracker has something where a real courier integration would put its data.
REEFER_DEMO_COURIER="GoLocal Express"

# ── Returns ───────────────────────────────────────────────────────────────
# What the 3-day return window counts from: 'purchase' (placed_at) or
# 'delivery' (delivered_at, falling back to placed_at when nothing arrived).
REEFER_RETURN_WINDOW_FROM=purchase
# Whether the parcel must have arrived first — before that it is a
# cancellation, which is a different thing.
REEFER_RETURN_REQUIRE_DELIVERED=true

# ── Email verification ────────────────────────────────────────────────────
# The check that actually proves the address exists. Off by default so signup
# stays testable while MAIL_MAILER=log.
REEFER_REQUIRE_EMAIL_VERIFICATION=false

# =============================================================================
#  Optional — only read when PAYMONGO_SECRET_KEY is set
# =============================================================================
# Publishable key handed to the SPA; it is what PayMongo.js tokenises cards
# with. Safe in a bundle. The secret key above never is.
PAYMONGO_PUBLIC_KEY=
# Where PayMongo returns the shopper after an e-wallet checkout. Both default
# to APP_URL + /checkout/success|failed. When the storefront is on its own
# domain you MUST set them — APP_URL is then the API host, which serves no
# /checkout page. Point them at the SPA, e.g.
#   https://reeferclothing.com/checkout
# ⚠ Note /checkout, not /checkout/success: the SPA has no success or failed
#   route — Checkout.jsx renders the outcome in-page from a `phase` state — so
#   the built-in default lands on the SPA's 404 even once the host is right.
#   Before going live, either add those routes to the SPA or keep the redirect
#   on /checkout and read the result from the query string.
# Left COMMENTED so an untouched append leaves them absent and the APP_URL
# default above actually applies — these are the only two keys in this file with
# a non-empty intended default, and a present-but-blank key is not the same as
# an unset one. Uncomment and fill in to override.
#PAYMONGO_SUCCESS_URL=
#PAYMONGO_FAILED_URL=

# ---------------------------------------------------------------------------------
# STOCK MANAGER (staff ERP at /api/storefront/stocks/*)
# ---------------------------------------------------------------------------------

# The first administrator, created by:
#   php artisan db:seed --class="Database\Seeders\Storefront\StockAdminSeeder" --force
#
# SEED THIS ON EVERY FRESH DEPLOYMENT, and do it before the domain is reachable.
# Stock\AuthController::register() grants the FIRST account ever created both
# `admin` and `approved` — a sensible bootstrap locally, a land-grab on a public
# domain, where the first stranger to hit the register endpoint would own the
# warehouse. Once ONE account exists every later registration lands `pending`.
#
# Leave the password BLANK and the seeder generates a strong one and prints it
# ONCE. Set it, and the seeder uses it verbatim. Either way the seeder never
# touches an account that already exists, so re-running a deploy cannot reset a
# password you have changed.
#
# ⚠ FIXED DEMO CREDENTIAL, DELIBERATE. admin/admin123 is set here so the sample
#   deployment has a known login for peer review. It is a weak, published password
#   on a public domain, and it opens the whole warehouse: inventory edit and
#   delete, order status writes, and the staff-approval screen. RATE_LIMIT_AUTH=0
#   would leave it unthrottled as well — set that back to 5 if this stays up.
#
#   Before anything real depends on this deployment, do BOTH:
#     1. blank STOCK_ADMIN_PASSWORD here (or set a strong one),
#     2. delete the existing row and re-seed, since the seeder skips accounts that
#        already exist:
#          php artisan tinker --execute="DB::table('storefront_stock_users')->where('username','admin')->delete();"
#          php artisan db:seed --class="Database\Seeders\Storefront\StockAdminSeeder" --force
STOCK_ADMIN_USERNAME=admin
STOCK_ADMIN_PASSWORD=admin123

# Shared secret for a service caller (e.g. another backend) to reach the stock API
# without a staff login. BLANK = no service access, which is the safe default.
# Generate: php -r "echo bin2hex(random_bytes(32));"
STOCK_SERVICE_TOKEN=

# ---------------------------------------------------------------------------------
# RATE LIMITS — requests per minute per IP. 0 = UNLIMITED.
# ---------------------------------------------------------------------------------
# ⚠ Ship PRODUCTION with real values. RATE_LIMIT_AUTH guards login for BOTH
# shoppers and warehouse staff; 0 removes brute-force protection from both.
#
# 60/5 are the built-in defaults and are correct for a public site. They are set
# to 0 in local development only, because the stock manager's dashboards fetch
# several endpoints per view and a 60/min cap answers 429 to every call once you
# click around — which on screen is indistinguishable from being logged out.
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5

# ---------------------------------------------------------------------------------
# DEMO AFFORDANCES — all must be OFF on a public domain
# ---------------------------------------------------------------------------------

# The account page's order tracker, clickable: POST /orders/{order}/advance lets a
# CUSTOMER walk their own order to Delivered. It applies the real stock movement
# (OrderStock::apply), so with COD — which takes no money — anyone with an account
# can drain on_hand across the whole catalogue for free, one order at a time.
# config/reefer.php defaults this to FALSE so a deployment that forgets it fails
# closed. Leave it false in production; fulfilment belongs to the stock manager.
REEFER_MANUAL_ADVANCE=false

# ⚠ THE PAYMENT GATEWAY IS SIMULATED unless PayMongo keys are configured above.
# The simulated one approves gcash/maya/card instantly and stamps
# payment_status='paid' with a fake reference. Fine for peer review; it means no
# money is ever taken, so treat every order on this deployment as fictional.
